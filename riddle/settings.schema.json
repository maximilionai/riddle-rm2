{
  "title": "The Diary — oracle settings",
  "env": "oracle.env",
  "fields": [
    {
      "key": "RIDDLE_OPENAI_KEY",
      "label": "API key",
      "kind": "secret",
      "placeholder": "sk-… / AIza…",
      "help": "Stored only on the tablet. Sent as `Authorization: Bearer <key>`. For a self-hosted Hermes gateway this is its API_SERVER_KEY."
    },
    {
      "key": "RIDDLE_OPENAI_BASE",
      "label": "API base URL",
      "kind": "text",
      "placeholder": "https://api.openai.com/v1",
      "help": "riddle appends /chat/completions. Plain http:// is fine for a LAN host (and required for a self-signed certificate, which cannot be trusted)."
    },
    {
      "key": "RIDDLE_OPENAI_MODEL",
      "label": "Model",
      "kind": "text",
      "placeholder": "gpt-4o-mini",
      "help": "Must be vision-capable."
    },
    {
      "key": "RIDDLE_OPENAI_REASONING",
      "label": "Reasoning effort",
      "kind": "select",
      "options": [
        "",
        "none",
        "low",
        "medium",
        "high"
      ],
      "help": "Only for thinking models (Gemini 3.x, o-series). Leave empty otherwise. \"none\" is for models that think by default and would otherwise ink their reasoning — Groq's qwen3.6 needs it."
    },
    {
      "key": "RIDDLE_OPENAI_MAX_TOKENS",
      "label": "Max tokens",
      "kind": "text",
      "placeholder": "2000",
      "help": "Runaway guard. Thinking models count hidden reasoning tokens against it — keep it roomy."
    },
    {
      "key": "RIDDLE_MEMORY",
      "label": "The diary remembers",
      "kind": "select",
      "options": [
        "",
        "off"
      ],
      "help": "When on (default), the diary keeps your pages on the tablet, Tom follows the conversation, and \"show me…\" conjures past pages. \"off\" disables all of it."
    },
    {
      "key": "RIDDLE_TZ_OFFSET",
      "label": "Timezone offset",
      "kind": "text",
      "placeholder": "-4",
      "help": "Hours from UTC, so the dates of conjured memories read right."
    }
  ],
  "presets": [
    {
      "name": "Hermes (self-hosted)",
      "values": {
        "RIDDLE_OPENAI_BASE": "http://192.168.1.x:8642/v1",
        "RIDDLE_OPENAI_MODEL": "hermes-agent",
        "RIDDLE_OPENAI_REASONING": ""
      }
    },
    {
      "name": "Gemini",
      "values": {
        "RIDDLE_OPENAI_BASE": "https://generativelanguage.googleapis.com/v1beta/openai",
        "RIDDLE_OPENAI_MODEL": "gemini-3.5-flash",
        "RIDDLE_OPENAI_REASONING": "low"
      }
    },
    {
      "name": "OpenAI",
      "values": {
        "RIDDLE_OPENAI_BASE": "https://api.openai.com/v1",
        "RIDDLE_OPENAI_MODEL": "gpt-4o-mini",
        "RIDDLE_OPENAI_REASONING": ""
      }
    },
    {
      "name": "OpenRouter",
      "values": {
        "RIDDLE_OPENAI_BASE": "https://openrouter.ai/api/v1",
        "RIDDLE_OPENAI_MODEL": "openai/gpt-4o-mini",
        "RIDDLE_OPENAI_REASONING": ""
      }
    },
    {
      "name": "Groq",
      "values": {
        "RIDDLE_OPENAI_BASE": "https://api.groq.com/openai/v1",
        "RIDDLE_OPENAI_MODEL": "qwen/qwen3.6-27b",
        "RIDDLE_OPENAI_REASONING": "none"
      }
    },
    {
      "name": "Cerebras",
      "values": {
        "RIDDLE_OPENAI_BASE": "https://api.cerebras.ai/v1",
        "RIDDLE_OPENAI_MODEL": "gemma-4-31b",
        "RIDDLE_OPENAI_REASONING": ""
      }
    }
  ]
}
